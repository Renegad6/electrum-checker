<?xml version="1.0" encoding="UTF-8"?>
<uml:Model xmi:version="20131001"
    xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
    xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML"
    xmi:id="_ascensorModel" name="Ascensor">
  <packagedElement xmi:type="uml:Enumeration" xmi:id="_doorState" name="EstadoPuerta">
    <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_doorOpen" name="Abierta"/>
    <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_doorClosing" name="Cerrando"/>
    <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_doorClosed" name="Cerrada"/>
  </packagedElement>
  <packagedElement xmi:type="uml:Enumeration" xmi:id="_thresholdState" name="EstadoUmbral">
    <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_thresholdFree" name="Libre"/>
    <ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="_thresholdOccupied" name="Ocupado"/>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="_elevator" name="Ascensor">
    <ownedAttribute xmi:type="uml:Property" xmi:id="_elevatorDoor" name="puerta" type="_doorState" lower="1" upper="1"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="_elevatorThreshold" name="umbral" type="_thresholdState" lower="1" upper="1"/>
  </packagedElement>
</uml:Model>
